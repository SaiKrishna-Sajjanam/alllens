# All-Lens keys for the server. This file lives only on the server (readable by you alone);
# never commit it, paste it into chat, or screenshot it.
# Keep the single quotes around each value: they protect special characters in passwords.

# Supabase -> Connect -> Session pooler URI, with your database password in it
DATABASE_URL=''
# The site address, e.g. https://alllens.vercel.app (links in emails)
SITE_URL=''
# Daily emails (leave empty until step 8: the email job then only does a dry run)
RESEND_API_KEY=''
EMAIL_FROM=''
# Optional: grouping threshold (default 0.905)
# GROUP_THRESHOLD='0.905'
