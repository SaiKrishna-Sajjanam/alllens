# Vuaz keys for the server. This file lives only on the server (readable by you alone);
# never commit it, paste it into chat, or screenshot it.
# Keep the single quotes around each value: they protect special characters in passwords.

# Supabase -> Connect -> Session pooler URI, with your database password in it
DATABASE_URL=''
# Translator (docs/TRANSLATE.md): the Apps Script Web app URL and its password (script property TOKEN)
TRANSLATE_URL=''
TRANSLATE_TOKEN=''
# Optional: extra languages to translate into, e.g. 'te' (same as the GitHub variable TRANSLATE_LANGS)
# TRANSLATE_LANGS='te'
# Optional: grouping threshold (default 0.905)
# GROUP_THRESHOLD='0.905'
