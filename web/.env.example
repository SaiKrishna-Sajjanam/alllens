# Copy to .env.local for local development (never commit .env.local).
# Supabase: Project settings -> API. The "publishable" / anon key is safe in the browser;
# row-level security decides what it can read and write.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# The address people use to reach the site (used in sign-in emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details shown on the Grievance and Privacy pages (required for public launch in India).
NEXT_PUBLIC_GRIEVANCE_OFFICER=[NAME OF GRIEVANCE OFFICER]
NEXT_PUBLIC_GRIEVANCE_EMAIL=[grievance@yourdomain]
NEXT_PUBLIC_CONTACT_EMAIL=[hello@yourdomain]

# Headline translation (docs/TRANSLATE.md). Server-only: no NEXT_PUBLIC_ prefix, never shown in the browser.
# Without them, headlines show in their original language.
TRANSLATE_URL=
TRANSLATE_TOKEN=
